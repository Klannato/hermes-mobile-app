<?xml version="1.0" encoding="utf-8"?>
<!-- Default is cleartext OFF (WSS tunnel only). Cleartext ws:// is allowed solely
     for the home LAN gateway (172.16.1.202) and the emulator's host alias, so the
     app can skip ngrok on the same Wi-Fi if the user types a ws:// URL manually. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.16.1.202</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
